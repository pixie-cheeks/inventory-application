<% const { id: trainerId, trainer_name, trainer_description, image_src } = trainerData; %>
<% const getPosessive = name => name.toLowerCase().endsWith('s') ? `${name}'` : `${name}'s`; %>

<div class="details">
  <div class="details__header">
    <h1 class="details__heading"><%= trainer_name %> (trainer)</h1>
    <div class="details__actions">
      <a href="/trainers/<%- trainerId %>/edit" class="btn details__btn" title="Edit">
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
          <path d="m15 5 4 4" />
        </svg>
      </a>
      <%- include(
          '../partials/delete',
          {
            deleteData: {
              categoryName: 'Trainer',
              itemName: trainer_name,
              formAction: `/trainers/${trainerId}`
            },
          }
        ) %>
    </div>
  </div>
</div>

<div class="details__grid">
  <img class="details__media" src="<%- image_src || '/images/no-image-icon.png' %> " alt="Appearance of <%- trainer_name %>">
  <div class="details__text">
    <p class="details__description"><%- trainer_description %></p>
  </div>
</div>

<% if (ownedPokemons.length > 0) { %>
<h2>Owned Pokemon</h2>
<ul class="cards">
  <% ownedPokemons.forEach(({id: pokemonId, pokemon_name, type_one, type_two, image_src: pokemon_image_src}) => { %>
  <li>
    <a href="/pokemon/<%- pokemonId %>" class="card">
      <img src="<%= pokemon_image_src || '/images/no-image-icon.png' %>" alt="Appearance of <%= pokemon_name %>" class="card__media category-card__media">
      <p class="card__title"><%- pokemon_name %></p>
    </a>
  </li>

  <% }) %>
</ul>
<% } %>