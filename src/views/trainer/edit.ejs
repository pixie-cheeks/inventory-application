<% const {id: trainerId, trainer_name, trainer_description, image_src } = trainerData; %>


<form action="/trainers/<%- trainerId %>/edit" method="post" class="form">
  <%- include('../partials/error') %>
  <div class="form__container">
    <h1 class="form__title">Edit Trainer</h1>
    <input type="hidden" name="id" value="<%- trainerId %>">
    <div class="form__field">
      <label for="admin-password">Enter Admin Password</label>
      <input type="password" id="admin-password" name="admin_password" required class="form__input">
    </div>
    <div class="form__field">
      <label for="name">Name</label>
      <input type="text" id="name" name="trainer_name" required value="<%- trainer_name %>" class="form__input" placeholder="Ash Ketchum">
    </div>
    <div class="form__field">
      <label for="description">Description</label>
      <textarea name="trainer_description" id="description" required class="form__input form__input--textarea" placeholder="Ash has a really nice cap"><%- trainer_description %></textarea>
    </div>
    <div class="form__field">
      <label for="image">Trainer Image URL</label>
      <input type="url" id="image" name="image_src" <%-image_src && `value="${image_src}"`  %> class="form__input" placeholder="https://some-page.com/some-image.jpg">
    </div>
    <% if (locals.allPokemon?.length > 0) { %>
    <div class="form__field">
      <label for="pokemon">Owned Pokemon</label>
      <select name="owned_pokemon" id="pokemon" multiple class="form__input">
        <option value="">Select</option>
        <% allPokemon.forEach(({id, pokemon_name, selected}) => { %>
        <option value="<%- id %>" <%- selected && 'selected="selected"' %>><%- pokemon_name %></option>
        <% }) %>
      </select>
    </div>
    <% } %>
    <button type="submit" class="btn form__btn">Save Updates</button>
  </div>

</form>