<div class="main__header">
  <h1 class="main__heading">All Trainers</h1>
  <a href="/trainers/new" class="main__btn btn">Add &plus;</a>
</div>
<% if (allTrainers.length > 0) { %>
<ul class="cards">
  <% for (const {id, trainer_name, trainer_description, image_src} of allTrainers) { %>
  <li>
    <a href="/trainers/<%- id %>" class="card">
      <img src="<%= image_src || '/images/no-image-icon.png' %>" alt="Appearance of <%= trainer_name %>" class="card__media category-card__media">
      <p class="card__title"><%- trainer_name %></p>
    </a>
  </li>
  <% } %>
</ul>
<% } else { %>
<div class="main__content">
  <img src="/images/empty-state.webp" alt="" class="main__media">
  <div class="main__empty-text">
    <p class="main__subtitle">Looks like there has been no trainer added yet. Go ahead and add one!</p>
  </div>
  <a href="/trainers/new" class="main__btn btn">Add a New Trainer</a>
</div>

<% } %>