<h1>List of all trainers</h1>
<a href="/trainers/new">Add a trainer</a>
<% if (allTrainers.length > 0) { %>
<ol>
  <% for (const {id, trainer_name, trainer_description} of allTrainers) { %>
  <li>
    <a href="/trainers/<%- id %>"><%- trainer_name %></a>
    <p><%- trainer_description %></p>
  </li>
  <% } %>
</ol>
<% } %>