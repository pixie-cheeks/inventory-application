<% if (allPokemonOfType.length === 0) { %>
<p>Oops! No pokemon of type <%- typeName %></p>
<% } else { %>
<h2>All pokemon of type <%- typeName %></h2>
<ol>
  <% for (const {id, pokemon_name, type_one, type_two} of allPokemonOfType) { %>
  <li>
    <p><a href="/pokemon/<%- id %>"><%- pokemon_name %></a></p>
    <dl>
      <dt>Type One</dt>
      <dd><%- type_one %></dd>
      <% if (locals.type_two) { %>
      <dt>Type Two</dt>
      <dd><%- type_two %></dd>
      <% } %>
    </dl>
  </li>
  <% } %>
</ol>
<% } %>