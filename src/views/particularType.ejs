<% if (allPokemonOfType.length === 0) { %>
<p>Oopsie! No pokemon with this type! LOL</p>
<% } else { %>
<ol>
  <% for (const {pokemon_name, type_one, type_two} of allPokemonOfType) { %>
  <li>
    <h2><%- pokemon_name %></h2>
    <dl>
      <dt>Type One</dt>
      <dd><%- type_one %></dd>
      <% if (locals.type_two) { %>
      <dt>Type Two</dt>
      <dd><%- type_two %></dd>
      <% } %>
    </dl>
  </li>
  <% } %>
</ol>
<% } %>