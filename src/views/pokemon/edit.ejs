<%- include('../partials/error') %>
<% const {id, pokemon_name, pokemon_description, type_one, type_two, image_src} = pokemonData %>

<form action="/pokemon/new" method="post" class="form page__form">
  <h1>Edit Pokemon Details</h1>

  <input type="hidden" name="id" value="<%- id %>">
  <div class="form__field">
    <label for="name">Name</label>
    <input type="text" id="name" name="pokemon_name" required value="<%- pokemon_name %>">
  </div>

  <div class="form__field">
    <label for="description">Description</label>
    <textarea class="textarea" name="pokemon_description" id="description" required><%- pokemon_description %></textarea>
  </div>

  <div class="form__field">
    <label for="type-one">Type One</label>
    <select id="type-one" name="type_one" required>
      <%- include('../partials/typesOptions', {selectedType: type_one}) %>
    </select>
  </div>

  <div class="form__field">
    <label for="type-two">Type Two</label>
    <select id="type-two" name="type_two">
      <%- include('../partials/typesOptions', {selectedType: type_two}) %>
    </select>
  </div>

  <div class="form__field">
    <label for="image">Pokemon Image URL</label>
    <input type="url" id="image" name="image_src">
  </div>

  <div class="form__field"><button type="submit">Save updates</button></div>

</form>