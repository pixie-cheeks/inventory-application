<%- include('../partials/error') %>

<% const {id: trainerId, trainer_name, trainer_description, image_src } = trainerData; %>

<form action="/trainers/<%- trainerId %>/edit" method="post" class="form page__form">
  <h1>Edit Trainer Details</h1>

  <input type="hidden" name="id" value="<%- trainerId %>">
  <div class="form__field">
    <label for="name">Name</label>
    <input type="text" id="name" name="trainer_name" required value="<%- trainer_name %>">
  </div>

  <div class="form__field">
    <label for="description">Description</label>
    <textarea class="textarea" name="trainer_description" id="description" required><%- trainer_description %></textarea>
  </div>

  <div class="form__field">
    <label for="image">Trainer Image URL</label>
    <input type="url" id="image" name="image_src" <%-image_src && `value="${image_src}"`  %>>
  </div>

  <% if (locals.allPokemon?.length > 0) { %>
  <div class="form__field">
    <label for="pokemon">Owned Pokemon</label>
    <select name="owned_pokemon" id="pokemon" multiple>
      <option value="">Select</option>
      <% allPokemon.forEach(({id, pokemon_name, selected}) => { %>
      <option value="<%- id %>" <%- selected && 'selected="selected"' %>><%- pokemon_name %></option>
      <% }) %>
    </select>
  </div>
  <% } %>

  <div class="form__field"><button type="submit">Save Updates</button></div>

</form>