<% const {id, pokemon_name, pokemon_description, type_one, type_two, image_src} = pokemonData %>

<form action="/pokemon/<%- id %>/edit" method="post" class="form page__form">
  <%- include('../partials/error') %>

  <div class="form__container">
    <h1>Edit Pok&eacute;mon Details</h1>

    <input type="hidden" name="id" value="<%- id %>">

    <div class="form__field">
      <label for="admin-password">Enter Admin Password</label>
      <input type="password" id="admin-password" name="admin_password" required class="form__input">
    </div>

    <div class="form__field">
      <label for="name">Name</label>
      <input type="text" id="name" name="pokemon_name" required value="<%- pokemon_name %>" class="form__input" placeholder="Pikachu">
    </div>

    <div class="form__field">
      <label for="description">Description</label>
      <textarea name="pokemon_description" id="description" required class="form__input" placeholder="An electric mouse pok&eacute;mon"><%- pokemon_description %></textarea>
    </div>

    <div class="form__field">
      <label for="type-one">Type One</label>
      <select id="type-one" name="type_one" required class="form__input">
        <%- include('../partials/typesOptions', {selectedType: type_one}) %>
      </select>
    </div>

    <div class="form__field">
      <label for="type-two">Type Two</label>
      <select id="type-two" name="type_two" class="form__input">
        <%- include('../partials/typesOptions', {selectedType: type_two}) %>
      </select>
    </div>

    <div class="form__field">
      <label for="image">Pokemon Image URL</label>
      <input type="url" id="image" name="image_src" class="form__input" placeholder="https://somepage.com/some-image.jpg">
    </div>

    <button type="submit" class="btn form__btn">Save updates</button>
  </div>

</form>