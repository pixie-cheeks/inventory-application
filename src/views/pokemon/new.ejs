<%- include('../partials/error') %>

<form action="/pokemon/new" method="post" class="form page__form">
  <h1>Create a new pokemon</h1>

  <div class="form__field">
    <label for="name">Name</label>
    <input type="text" id="name" name="pokemon_name" required>
  </div>

  <div class="form__field">
    <label for="description">Description</label>
    <textarea class="textarea" name="pokemon_description" id="description" required></textarea>
  </div>

  <div class="form__field">
    <label for="type-one">Type One</label>
    <select id="type-one" name="type_one" required>
      <%- include('../partials/typesOptions') %>
    </select>
  </div>

  <div class="form__field">
    <label for="type-two">Type Two</label>
    <select id="type-two" name="type_two">
      <%- include('../partials/typesOptions') %>
    </select>
  </div>

  <div class="form__field">
    <label for="image">Pokemon Image URL</label>
    <input type="url" id="image" name="image_src">
  </div>

  <div class="form__field"><button type="submit">Add Pokemon</button></div>

</form>