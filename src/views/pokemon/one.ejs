<% const {id: pokemonId, pokemon_name, pokemon_description, image_src, type_one, type_two} = pokemon %>
<div class="details">
  <div class="details__header">
    <h1 class="details__heading"><%= pokemon_name %> (pok&eacute;mon)</h1>
    <div class="details__actions">
      <a href="/pokemon/<%- pokemonId %>/edit" class="btn details__btn" title="Edit"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
          <path d="m15 5 4 4" />
        </svg>
      </a>
      <%- include(
      '../partials/delete',
      {
        deleteData: {
          categoryName: 'Pok&eacute;mon',
          itemName: pokemon_name,
          formAction: `/pokemon/${pokemonId}`
        },
      }
    ) %>
    </div>
  </div>
</div>

<div class="details__grid">
  <img class="details__media" src="<%- image_src || '/images/no-image-icon.png' %> " alt="Appearance of <%- pokemon_name %>">
  <div class="details__text">
    <dl class="details__list">
      <div class="details__list-item">
        <dt>Type One</dt>
        <dd><a href="/types/<%- type_one %>" class="card details__card"><%- type_one %></a></dd>
      </div>
      <% if (type_two) { %>
      <div class="details__list-item">
        <dt>Type Two</dt>
        <dd><a href="/types/<%- type_two %>" class="card details__card"><%- type_two %></a></dd>
      </div>
      <% } %>
    </dl>
    <p class="details__description"><%- pokemon_description %></p>
  </div>
</div>


<% if (trainerOwners.length > 0) { %>
<div class="details__block">
  <h2 class="details__title">Owned by the following trainers:</h2>
  <ul class="cards">
    <% trainerOwners.forEach(({id, trainer_name, image_src: trainer_image_src}) => { %>
    <li>
      <a href="/trainers/<%- id %>" class="card">
        <img src="<%= trainer_image_src || '/images/no-image-icon.png' %>" alt="Appearance of <%= trainer_name %>" class="card__media category-card__media">
        <p class="card__title"><%- trainer_name %></p>
      </a>
    </li>

    <% }) %>
  </ul>
</div>

<% } %>