<div class="details">
  <div class="details__header">
    <h1 class="details__heading"><%= typeName %> (type)</h1>
    <div class="details__actions">
      <a href="/types/<%- typeName %>/edit" class="btn details__btn" title="Edit"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
          <path d="m15 5 4 4" />
        </svg></a>
      <%- include(
      '../partials/delete',
      {
        deleteData: {
          categoryName: 'Type',
          itemName: typeName,
          formAction: `/types/${typeName}`
        },
      }
    ) %>
    </div>
  </div>
</div>
<% if (allPokemonOfType.length === 0) { %>
<div class="main__content">
  <img src="/images/empty-state.webp" alt="" class="main__media">
  <div class="main__empty-text">
    <p class="main__subtitle">Oops! No pokemon of type <%- typeName %>. Why not add one?</p>
  </div>
  <a href="/pokemon/new" class="main__btn btn">Add a New Pokemon</a>
</div>

<% } else { %>
<h2>All pokemon of type <%- typeName %></h2>
<ol>
  <% for (const {id, pokemon_name, type_one, type_two} of allPokemonOfType) { %>
  <li>
    <p><a href="/pokemon/<%- id %>"><%- pokemon_name %></a></p>
    <dl>
      <dt>Type One</dt>
      <dd><%- type_one %></dd>
      <% if (locals.type_two) { %>
      <dt>Type Two</dt>
      <dd><%- type_two %></dd>
      <% } %>
    </dl>
  </li>
  <% } %>
</ol>
<% } %>