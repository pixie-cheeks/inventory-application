<%- include('../partials/error') %>

<form action="/types/new" method="post" class="form page__form">
  <h1>Create a new type</h1>

  <div class="form__field">
    <label for="name">Name</label>
    <input type="text" id="name" name="type_name" required>
  </div>

  <div class="form__field">
    <label for="image">Type Image URL</label>
    <input type="url" id="image" name="image_src">
  </div>

  <div class="form__field"><button type="submit">Add Type</button></div>

</form>