<% if (locals.deleteData) { %>
<% const {categoryName, itemName, formAction} = deleteData %>

<dialog id="delete-dialog" closedby="any">
  <h1>Delete <%- categoryName %></h1>
  <p>You're going to delete the <%- categoryName.toLowerCase() %> "<%= itemName %>." Are you sure?</p>

  <form id="delete-form" action="<%- formAction %>">
    <label for="delete-password">Enter Admin Password</label>
    <input type="password" name="admin_password" id="delete-password">
    <button type="button" commandfor="delete-dialog" command="close">No, Keep it.</button>
    <button type="submit">Yes, Delete it!</button>
  </form>
</dialog>

<button type="button" id="open-delete-dialog-btn" commandfor="delete-dialog" command="show-modal" class="btn details__btn" title="Delete">
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="" aria-hidden="true">
    <circle cx="11" cy="13" r="9" />
    <path d="M14.35 4.65 16.3 2.7a2.41 2.41 0 0 1 3.4 0l1.6 1.6a2.4 2.4 0 0 1 0 3.4l-1.95 1.95" />
    <path d="m22 2-1.5 1.5" />
  </svg>
</button>

<script type="module" src="/scripts/deleteDialog.js"></script>
<% } %>