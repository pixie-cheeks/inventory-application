<header class="header">
  <div class="page__container header__container">
    <a href="/" aria-label="Home page" class="header__logo-container link">
      <img src="/images/pokeball.webp" alt="Pok&eacute;Inventory page logo" class="header__logo">
      <span><span class="header__primary-text">Pok&eacute;</span><span class="header__secondary-text">Inventory</span></span>
    </a>
    <button type="button" class="hamburger-menu" id="js-hamburger-menu" aria-label="Toggle navigation menu" aria-expanded="false">
      <span aria-hidden="true" class="hamburger-menu__stripe"></span>
      <span aria-hidden="true" class="hamburger-menu__stripe"></span>
      <span aria-hidden="true" class="hamburger-menu__stripe"></span>
    </button>
    <nav class="header__nav" id="js-nav-list">
      <ul class="header__list">
        <li>
          <a href="/types" class="header__nav-link link">Types</a>
        </li>
        <li>
          <a href="/pokemon" class="header__nav-link link">Pok&eacute;mon</a>
        </li>
        <li>
          <a href="/trainers" class="header__nav-link link">Trainers</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
<script type="module">
  const hamburgerMenuDom = document.querySelector('#js-hamburger-menu');
  const navListDom = document.querySelector('#js-nav-list');
  const activeClass = 'active';

  hamburgerMenuDom.addEventListener('click', () => {
    hamburgerMenuDom.ariaExpanded = hamburgerMenuDom.classList.toggle(activeClass);
    navListDom.classList.toggle(activeClass);
  });

  console.log({
    hamburgerMenuDom,
    navListDom
  });
</script>