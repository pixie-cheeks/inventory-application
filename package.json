{
  "name": "practice-node",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.ts",
  "private": true,
  "files": [],
  "engines": {
    "node": ">=21.2.0"
  },
  "scripts": {
    "start": "node .",
    "watch": "node --watch .",
    "lint:css": "stylelint .",
    "lint": "eslint",
    "prepare": "husky",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "packageManager": "pnpm@10.16.0",
  "dependencies": {
    "dotenv": "17.2.2",
    "ejs": "3.1.10",
    "express": "5.1.0",
    "express-async-handler": "1.2.0",
    "express-validator": "7.2.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "1.9.0",
    "@pixie-cheeks/eslint-config": "16.0.0",
    "@pixie-cheeks/stylelint-config": "5.0.0",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "cspell": "9.2.1",
    "ejs-lint": "^2.0.1",
    "eslint": "9.36.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "husky": "9.1.7",
    "jiti": "^2.6.0",
    "lint-staged": "16.2.0",
    "prettier": "3.6.2",
    "stylelint": "16.24.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "prettier": {
    "singleQuote": true,
    "plugins": [
      "@awmottaz/prettier-plugin-void-html"
    ]
  },
  "stylelint": {
    "extends": [
      "@pixie-cheeks/stylelint-config",
      "@pixie-cheeks/stylelint-config/bem"
    ],
    "ignoreFiles": [
      "**/*",
      "!src/**/*.css"
    ]
  },
  "cspell": {
    "version": "0.2",
    "language": "en,en-GB,lorem",
    "allowCompoundWords": true,
    "enableGlobDot": true,
    "dictionaries": [
      "html"
    ],
    "words": [
      "awmottaz",
      "besthyhy",
      "esbuild",
      "ilike",
      "pgdatabase",
      "pghost",
      "pguser",
      "unrs"
    ],
    "ignorePaths": [
      ".git",
      ".husky/_",
      "dist",
      "node_modules",
      "pnpm-lock.yaml"
    ]
  },
  "lint-staged": {
    "*": [
      "cspell --no-must-find-files",
      "prettier --write --ignore-unknown"
    ],
    "*.css": [
      "stylelint"
    ]
  }
}
