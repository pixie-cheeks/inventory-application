{
  "name": "practice-node",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.ts",
  "private": true,
  "files": [],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc && node dist/tools/copyAssets.js",
    "preview": "node dist/app.js",
    "start": "tsx src/app.ts",
    "watch": "tsx --watch .",
    "populateDB": "tsx src/db/populateDb.ts",
    "lint:css": "stylelint .",
    "lint": "eslint",
    "prepare": "husky",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "dotenv": "17.4.2",
    "ejs": "3.1.10",
    "express": "5.2.1",
    "express-async-handler": "1.2.0",
    "express-validator": "7.3.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "2.2.1",
    "@pixie-cheeks/eslint-config": "17.0.0",
    "@pixie-cheeks/stylelint-config": "5.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/shelljs": "0.10.0",
    "cspell": "10.0.1",
    "ejs-lint": "2.0.1",
    "eslint": "9.39.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "16.2.7",
    "prettier": "3.9.6",
    "shelljs": "0.10.0",
    "stylelint": "16.26.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "prettier": {
    "singleQuote": true,
    "plugins": [
      "@awmottaz/prettier-plugin-void-html"
    ]
  },
  "stylelint": {
    "extends": [
      "@pixie-cheeks/stylelint-config",
      "@pixie-cheeks/stylelint-config/bem"
    ],
    "ignoreFiles": [
      "**/*",
      "!src/**/*.css"
    ]
  },
  "cspell": {
    "version": "0.2",
    "language": "en,en-GB,lorem",
    "allowCompoundWords": true,
    "enableGlobDot": true,
    "dictionaries": [
      "html"
    ],
    "words": [
      "awmottaz",
      "besthyhy",
      "esbuild",
      "Golubev",
      "ilike",
      "Oopsie",
      "pgdatabase",
      "pghost",
      "pguser",
      "unrs"
    ],
    "ignorePaths": [
      ".git",
      ".husky/_",
      "dist",
      "node_modules",
      "pnpm-lock.yaml"
    ]
  },
  "lint-staged": {
    "*": [
      "cspell --no-must-find-files",
      "prettier --write --ignore-unknown"
    ],
    "*.sql": [
      "sqlfluff fix --dialect postgres"
    ],
    "*.css": [
      "stylelint"
    ]
  }
}
